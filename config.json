{
  "defaultHomeserver": 0,
  "homeserverList": ["kiconnect.at"],
  "allowCustomHomeservers": false,
  "disableSSO": true,
  "hidePasswordLogin": true,
  "portalUrl": "https://portal.kiconnect.at",
  "keycloakLogout": {
    "issuer": "https://sso.id-am.at/realms/KIconnect",
    "clientId": "kiconnect-matrix"
  },
  "keycloakUnlock": {
    "issuer": "https://sso.id-am.at/realms/KIconnect",
    "clientId": "kiconnect_cinny",
    "redirectUri": "https://cinny.kiconnect.at/unlock/callback"
  },
  "kiconnectLock": {
    "timeoutMinutes": 5,
    "preferencesUrl": "https://portal.kiconnect.at/api/user/preferences/idle-timeout"
  },

  "appearance": {
    "theme": "light"
  },

  "featuredCommunities": {
    "openAsDefault": false,
    "spaces": [],
    "rooms": [],
    "servers": []
  },

  "hashRouter": {
    "enabled": false,
    "basename": "/"
  }
}

# Copy this schema locally to .env.local and replace every placeholder.
# Only the validated KIconnect dev and prod host combinations are accepted.
# Never commit the local file.
KICONNECT_ENV=REPLACE_WITH_dev_OR_prod
KICONNECT_PUBLIC_HOSTNAME=REPLACE_WITH_PUBLIC_CINNY_HOSTNAME
KICONNECT_MATRIX_SERVER=REPLACE_WITH_MATRIX_SERVER_NAME
KICONNECT_PORTAL_URL=https://REPLACE_WITH_PORTAL_HOSTNAME

KICONNECT_KEYCLOAK_LOGOUT_ISSUER=https://REPLACE_WITH_SSO_HOSTNAME/realms/KIconnect
KICONNECT_KEYCLOAK_LOGOUT_CLIENT_ID=kiconnect-matrix
KICONNECT_KEYCLOAK_UNLOCK_ISSUER=https://REPLACE_WITH_SSO_HOSTNAME/realms/KIconnect
KICONNECT_KEYCLOAK_UNLOCK_CLIENT_ID=kiconnect_cinny
KICONNECT_KEYCLOAK_UNLOCK_REDIRECT_URI=https://REPLACE_WITH_PUBLIC_CINNY_HOSTNAME/unlock/callback

KICONNECT_LOCK_TIMEOUT_MINUTES=5
KICONNECT_LOCK_PREFERENCES_URL=https://REPLACE_WITH_PORTAL_HOSTNAME/api/user/preferences/idle-timeout

# Both web-push values must be set together or left empty.
KICONNECT_WEB_PUSH_GATEWAY_URL=
KICONNECT_WEB_PUSH_VAPID_PUBLIC_KEY=

KICONNECT_PWA_NAME=REPLACE_WITH_PWA_NAME
KICONNECT_PWA_SHORT_NAME=REPLACE_WITH_PWA_SHORT_NAME
KICONNECT_PWA_DESCRIPTION=REPLACE_WITH_PWA_DESCRIPTION
KICONNECT_PWA_ID=REPLACE_WITH_STABLE_PWA_ID
